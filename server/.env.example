# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit a real key.

# Required. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional (defaults shown).
PORT=8787
RATE_LIMIT_PER_DAY=20
DAILY_SPEND_CAP_USD=5
# Lock this down to your deployed Vibe Check origin once you have one
# (e.g. https://yourname.github.io); "*" allows any site, including file://.
ALLOWED_ORIGIN=*

# Optional — override the built-in placeholder $/million-token rates used to
# estimate spend against DAILY_SPEND_CAP_USD. Check console.anthropic.com for
# your actual current pricing per model.
# PRICE_CLAUDE_OPUS_5_IN=15
# PRICE_CLAUDE_OPUS_5_OUT=75
# PRICE_CLAUDE_SONNET_5_IN=3
# PRICE_CLAUDE_SONNET_5_OUT=15
# PRICE_CLAUDE_HAIKU_4_5_IN=0.8
# PRICE_CLAUDE_HAIKU_4_5_OUT=4
